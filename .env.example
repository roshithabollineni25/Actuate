# ResQMesh AI - Environment Configuration Template

# ==============================================================================
# Backend Configuration
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="ResQMesh AI API"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security / Authentication
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (Supabase PostgreSQL Session Pooler on port 5432 with psycopg 3)
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/postgres

# AI / Google Gemini
# Note: Never commit production API keys to source control
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="ResQMesh AI"
VITE_APP_TAGLINE="AI-Powered Emergency Coordination. Human-Verified Response."
